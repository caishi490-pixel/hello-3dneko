# Hello 3DNeko Environment Variables (100% BYOK — Keep real keys out of git)
# Copy this file to `.env` locally before running live Blender/AI jobs.

# Set this to the full path of the Blender executable if PATH and common install folders do not locate it.
# On PowerShell, set $env:HELLO_3DNEKO_BLENDER_EXE for the current terminal before running the CLI.
HELLO_3DNEKO_BLENDER_EXE=

# Optional AutoRemesher 1.2.0 CLI. A compatible autoremesher on PATH is detected too.
HELLO_3DNEKO_AUTOREMESHER_EXE=

# Optional standalone Python environment with PyMeshLab 2025.7.post1 installed.
HELLO_3DNEKO_PYMESHLAB_PYTHON=

# External BYOK 3D / Image agent CLIs (configured per user's own local installation)
HELLO_3DNEKO_HYPER3D_CMD=hyper3d.cmd
HELLO_3DNEKO_CODEX_CMD=codex.cmd

# Optional: path to local key file or token when using custom ComfyUI image backend
HELLO_3DNEKO_COMFY_KEY_FILE=

# Optional: path to local desktop bridge script & python only when using `--codex-mode desktop`
HELLO_3DNEKO_CODEX_BRIDGE_SCRIPT=
HELLO_3DNEKO_CODEX_BRIDGE_PYTHON=
